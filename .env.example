# ===== Claude API =====
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ===== WordPress =====
# 사이트 주소 (https:// 포함, 끝 슬래시 없이). 예: https://slow7.co.kr
WP_SITE_URL=
# 워드프레스 로그인 아이디
WP_USERNAME=
# Application Password (워드프레스 사용자 프로필에서 발급, 공백 포함 그대로)
WP_APP_PASSWORD=
# 글이 들어갈 카테고리 (없으면 자동 생성)
WP_DEFAULT_CATEGORY=슬로우조깅
# publish(바로 공개) 또는 draft(초안으로만 저장)
WP_POST_STATUS=publish

# ===== 이미지 호스팅 (GitHub raw, 썸네일용) =====
GITHUB_REPO=yolkgit/slow7
GITHUB_BRANCH=main

# ===== Telegram 검수 봇 =====
# BotFather에서 /newbot 으로 만든 봇 토큰
TELEGRAM_BOT_TOKEN=
# 본인 chat_id (scripts/tg_check.py 로 확인)
TELEGRAM_CHAT_ID=

# ===== Pexels 본문 이미지 (무료, 선택) =====
# https://www.pexels.com/api/ 에서 무료 발급. 없으면 본문 이미지 생략됨
PEXELS_API_KEY=

# ===== SNS 크로스포스팅 (블로그 유입, 자동 게시만) =====
# 어떤 플랫폼 쓸지 (비우면 토큰 있는 것 자동 감지). 예: x,facebook
SNS_PLATFORMS=

# X (트위터) — developer.x.com 앱에서 발급 (Read and Write 권한)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# 페이스북 페이지 — Graph API 페이지 액세스 토큰 (장기)
FB_PAGE_ID=
FB_PAGE_TOKEN=

# 스레드 재도전 (새 계정/앱, 자동 게시만)
THREADS_PROMO_TOKEN=
THREADS_PROMO_USER_ID=

# 인스타그램 비즈니스 (이미지 필수, 유입 약함)
IG_USER_ID=
IG_ACCESS_TOKEN=

# ===== 운영 옵션 =====
# 대표 이미지(카드 썸네일) 자동 생성·첨부 여부
ATTACH_CARD_IMAGE=true
# 검수 모드: true면 draft 생성+텔레그램 알림, '발행' 응답 시 공개
REVIEW_MODE=true
# DRY_RUN=true 이면 실제 발행 안하고 콘솔에만 출력
DRY_RUN=false
