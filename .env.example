# ===== Threads (Meta) =====
# Meta 개발자 콘솔에서 발급받은 장기 액세스 토큰 (60일짜리, 자동 갱신 가능)
THREADS_ACCESS_TOKEN=
# 본인 Threads 유저 ID (숫자) - /me?fields=id 로 확인
THREADS_USER_ID=

# ===== Claude API =====
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
# 사용할 모델 (기본: 가성비 좋은 haiku)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ===== 이미지 호스팅 =====
# 카드뉴스를 GitHub raw로 서빙하기 위한 정보 (Actions에서 자동 주입됨)
GITHUB_REPO=your-username/slow7
GITHUB_BRANCH=main

# ===== 운영 옵션 =====
# 카드뉴스를 항상 함께 게시할지 (true/false). false면 텍스트만
ATTACH_CARD_IMAGE=true
# 답글 자동 모드 (true/false)
AUTO_REPLY_ENABLED=true
# DRY_RUN=true 이면 실제 게시 안하고 콘솔에만 출력
DRY_RUN=false
