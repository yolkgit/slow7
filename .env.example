# ===== Claude API =====
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ===== WordPress =====
# 사이트 주소 (https:// 포함, 끝 슬래시 없이). 예: https://slow7.co.kr
WP_SITE_URL=
# 워드프레스 로그인 아이디
WP_USERNAME=
# Application Password (워드프레스 사용자 프로필에서 발급, 공백 포함 그대로)
WP_APP_PASSWORD=
# 글이 들어갈 카테고리 (없으면 자동 생성)
WP_DEFAULT_CATEGORY=슬로우조깅
# publish(바로 공개) 또는 draft(초안으로만 저장)
WP_POST_STATUS=publish

# ===== 이미지 호스팅 (GitHub raw, 썸네일용) =====
GITHUB_REPO=yolkgit/slow7
GITHUB_BRANCH=main

# ===== Telegram 검수 봇 =====
# BotFather에서 /newbot 으로 만든 봇 토큰
TELEGRAM_BOT_TOKEN=
# 본인 chat_id (scripts/tg_check.py 로 확인)
TELEGRAM_CHAT_ID=

# ===== 운영 옵션 =====
# 대표 이미지(카드 썸네일) 자동 생성·첨부 여부
ATTACH_CARD_IMAGE=true
# 검수 모드: true면 draft 생성+텔레그램 알림, '발행' 응답 시 공개
REVIEW_MODE=true
# DRY_RUN=true 이면 실제 발행 안하고 콘솔에만 출력
DRY_RUN=false
